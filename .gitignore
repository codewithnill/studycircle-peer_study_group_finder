# ============================================================
# StudyCircle — Root .gitignore
# Monorepo: backend (NestJS) + frontend (Next.js)
# RULE: .env files are NEVER committed. See bottom of file.
# ============================================================

# ---------- Secrets / environment ----------
# Block every .env variant, then explicitly allow the template.
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key

# ---------- Node / dependencies ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ---------- Build output ----------
# NestJS
dist/
build/
# Next.js
.next/
out/
# generic
*.tsbuildinfo

# ---------- Prisma ----------
# Generated client (regenerated by `npx prisma generate`)
backend/node_modules/.prisma/
backend/node_modules/@prisma/
# Local SQLite / temp DB files (we use PostgreSQL, but belt-and-braces)
*.db
*.db-journal
*.sqlite
*.sqlite3
# Migration temp / shadow DB artifacts
prisma/*.tmp

# ---------- Private file uploads ----------
# The files section stores uploads in a PRIVATE folder (MVP plan, Section 4).
# These must never be committed or served publicly.
backend/uploads/
backend/private/
uploads/
private-uploads/

# ---------- Test / coverage ----------
coverage/
.nyc_output/
*.lcov

# ---------- Logs ----------
logs/
*.log

# ---------- OS noise ----------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- Editor noise ----------
# Ignore personal VS Code settings, but keep shared ones.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ---------- Misc ----------
.temp/
.tmp/
.cache/
.eslintcache
.next-env.d.ts

# ============================================================
# SANITY CHECK — what should NEVER appear in `git status`:
#   .env            (any .env file)
#   node_modules/   (any dependency folder)
#   dist/  .next/   (build output)
#   uploads/        (private files)
# If any of these show up as untracked, STOP and tell the Team Lead.
# ============================================================






/documentation/claude_setup
/documentation/deepseek_prompt
/documentation/git
/documentation/postgres


backend/src/generated/