# the address of the nestjs api, including the /api/v1 prefix. no slash at the end.
# the axios file reads this value once and puts it in front of every request path.
# safety: every variable whose name starts with NEXT_PUBLIC_ is copied into the browser code,
# so anyone who opens the site can read it. never put a password, a secret, or a token here.
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"