DATABASE_URL="postgresql://studycircle_user:password@localhost:5432/studycircle?schema=public"
SHADOW_DATABASE_URL="postgresql://studycircle_user:password@localhost:5432/studycircle_shadow?schema=public"
# Used only by the e2e tests. The database name must end with _test. Never point this at the dev database.
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/studycircle_test?schema=public"

# Demo only. The seed script uses this to set the admin password. Choose your own value in backend/.env.
SEED_ADMIN_PASSWORD="change_me_demo_only"


# secret that signs the short login token (jwt). use a long random value, at least 32 characters. never reuse a real one here.
JWT_ACCESS_SECRET="random_value_that_is_at_least_x_characters_long"
# address of the frontend. the api allows only this address to send cookies. no slash at the end.
FRONTEND_URL="http://localhost:3001"